# ─────────────────────────────────────────────────────────────────────────────
#  job-hunter-japan  ·  Environment Variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose one: anthropic | openai | ollama
# - anthropic  → Claude API  (console.anthropic.com — $5 free credits on signup)
#                NOTE: Claude.ai Pro is chat-only; API is billed separately.
# - openai     → OpenAI API  (platform.openai.com)
# - ollama     → FREE local inference (install from ollama.com, no key needed)
AI_PROVIDER=anthropic

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# Get key at https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model to use (default: claude-haiku-4-5-20251001 — cheapest option)
# Other options: claude-sonnet-4-6, claude-opus-4-7
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── OpenAI (alternative) ─────────────────────────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ── Ollama (free, runs locally) ───────────────────────────────────────────────
# Install Ollama: https://ollama.com
# Then run:  ollama pull llama3
# No API key needed!
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── Auto-Apply settings ───────────────────────────────────────────────────────
# Enable auto-apply (default: false — scrape + cover letter only)
# APPLY_JOBS=false

# Safety: DRY_RUN opens browser but never clicks Submit (default: TRUE)
# Set to false only when you're happy with the results
# DRY_RUN=true

# Set to true to auto-submit without asking you to confirm each one
# AUTO_SUBMIT=false

# Max jobs to attempt per run (default: 3)
# APPLY_LIMIT=3

# Your contact info for application forms
# APPLICANT_PHONE=+91xxxxxxxxxx
# APPLICANT_EMAIL=ovyas24@gmail.com
# APPLICANT_LINKEDIN=https://www.linkedin.com/in/om-prakash-vyas-68b9a2160

# Absolute path to your resume PDF for file upload fields
# RESUME_PATH=/home/om/Documents/Om_Prakash_Vyas_Resume.pdf

# ── Scraper settings ──────────────────────────────────────────────────────────
# Max jobs to collect per source (default: 20)
# MAX_JOBS_PER_SOURCE=20

# Polite delay between HTTP requests in ms (default: 1500)
# REQUEST_DELAY_MS=1500

# Output directory for CSV/JSON results (default: results)
# OUTPUT_DIR=results
